# Lightweight alternative to Dagster: add with `crontab -e`, replacing /path/to/Fairsend.
# ECB reference rates are published around 16:00 CET on working days.

# Daily: refresh FX rates, then check rate alerts (17:30 Berlin time = 15:30 UTC in summer, 16:30 UTC in winter)
40 16 * * 1-5  cd /path/to/Fairsend && .venv/bin/fairsend fx >> data/cron.log 2>&1 && .venv/bin/fairsend alerts >> data/cron.log 2>&1

# Weekly: download a new World Bank quarter if one is out, then rebuild (no-op otherwise)
0 6 * * 1      cd /path/to/Fairsend && .venv/bin/fairsend update >> data/cron.log 2>&1
