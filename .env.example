# Copy to .env and fill in what you need. Everything has a working default.

# Storage
FAIRSEND_DB=data/fairsend.db
FAIRSEND_RPW_FILE=                      # defaults to the newest data/raw/rpw_dataset_*.xlsx

# Local LLM (Ollama). Default qwen3.5:4b; any open model works (mistral:7b-instruct was the original).
OLLAMA_HOST=http://localhost:11434
FAIRSEND_LLM_MODEL=qwen3.5:4b

# Retrieval
FAIRSEND_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR: path to the tesseract binary (defaults to .tools/tesseract/bin/tesseract, then PATH)
TESSERACT_CMD=

# Link included in alert messages
FAIRSEND_APP_URL=http://localhost:8501

# Alerts. With no channel configured, alerts are written to data/outbox/ (useful for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=

# How long Ollama keeps the model in memory between questions
FAIRSEND_LLM_KEEP_ALIVE=1h
